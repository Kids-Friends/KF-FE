# 이 파일을 복사해 .env 로 만든 뒤 환경에 맞게 값을 채우세요.
#   cp .env.example .env
# .env 는 커밋되지 않습니다(.gitignore). build.gradle 이 빌드 시 BuildConfig 로 주입합니다.

# 백엔드(KF_BE) 베이스 URL (예: ngrok 주소 또는 http://<서버IP>:8080/)
API_BASE_URL=https://your-backend-host/

# 물건 맞추기 놀이 — 파이썬 비전 WebSocket 서버 (ws://<파이썬IP>:포트)
VISION_WS_URL=ws://10.0.0.10:8765
