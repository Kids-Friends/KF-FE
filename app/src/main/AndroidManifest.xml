<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kidsFriend">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".KidsFriendApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TemiApplication">
        <activity
            android:name=".domain.photo.service.PhotoPlayActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity
            android:name=".domain.quiz.service.QuizActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity
            android:name=".domain.quiz.service.QuizIntroActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity
            android:name=".domain.guide.service.GuidePlayActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity
            android:name=".domain.call.ui.FriendSelectionActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity
            android:name=".domain.call.ui.VoiceCallActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity
            android:name=".domain.dust.service.DustVideoActivity"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
        <activity android:name=".MainActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 테미 런처 스킬 등록 -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.SKILL"
            android:value="Kids_Friend"/>
        <!-- 상단 시스템(타이틀)바 숨김: UI_MODE=4 (런타임 hideTopBar()와 병행) -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.UI_MODE"
            android:value="4"/>
        <!-- 키오스크 모드 허용 선언 (테미 런처가 이 앱을 키오스크 후보로 인식) -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.KIOSK"
            android:value="TRUE"/>
        <!-- 테미의 기본 NLP/Voice 대화 레이어를 이 앱이 직접 처리하도록 선언 -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.OVERRIDE_CONVERSATION_LAYER"
            android:value="TRUE"/>
        <!-- SDK 권한 선언: setTtsVoice(목소리 변경)에 필요한 SETTINGS 권한을 요청할 수 있게 함 -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.PERMISSIONS"
            android:value="com.robotemi.permission.settings"/>
    </application>

</manifest>
