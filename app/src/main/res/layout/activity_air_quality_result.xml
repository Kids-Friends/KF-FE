<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_air_quality"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    tools:context=".domain.dust.service.AirQualityResultActivity">

    <!-- 배경에 퍼지는 컬러 글로우 (공기 상태에 따라 색상 변경) -->
    <View
        android:id="@+id/view_status_glow"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_gravity="center"
        android:alpha="0.4"
        android:background="@drawable/button_circle_play" />

    <!-- 전체 화면 블러 패널 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_air_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="40dp">

            <!-- 상단 제목 -->
            <TextView
                android:id="@+id/text_air_title"
                style="@style/TemiScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="지금 우리 카페 공기는?"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 중앙 결과 영역 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/btn_air_confirm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_air_title">

                <ImageView
                    android:id="@+id/image_air_face"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/face_peaceful" />

                <TextView
                    android:id="@+id/text_air_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:textColor="@color/kid_blue"
                    tools:text="보통🙂" />

                <TextView
                    android:id="@+id/text_air_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/status_background"
                    android:gravity="center"
                    android:paddingHorizontal="48dp"
                    android:paddingVertical="18dp"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="공기가 깨끗해요! 즐겁게 놀아요." />
            </LinearLayout>

            <!-- 하단 확인 버튼 -->
            <Button
                android:id="@+id/btn_air_confirm"
                style="@style/TemiPrimaryButton"
                android:layout_width="320dp"
                android:layout_height="88dp"
                android:layout_marginBottom="20dp"
                android:text="알겠어!"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- 종료 아이콘 (표준 디자인) -->
    <ImageButton
        android:id="@+id/btn_air_back"
        style="@style/TemiIconButton"
        android:layout_margin="28dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="종료" />

</FrameLayout>
