<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <Button
            android:id="@+id/button_back"
            style="@style/TemiBackButton"
            android:text="@string/common_back" />

        <TextView
            style="@style/TemiScreenTitle"
            android:text="@string/call_title" />

        <TextView
            style="@style/TemiScreenDescription"
            android:text="@string/call_description" />

        <LinearLayout
            android:id="@+id/panel_call_form"
            style="@style/TemiPanel"
            android:orientation="vertical">

            <Button
                android:id="@+id/button_reason_help"
                style="@style/TemiOptionButton"
                android:text="@string/call_reason_help" />

            <Button
                android:id="@+id/button_reason_injury"
                style="@style/TemiOptionButton"
                android:layout_marginTop="12dp"
                android:text="@string/call_reason_injury" />

            <Button
                android:id="@+id/button_reason_lost_item"
                style="@style/TemiOptionButton"
                android:layout_marginTop="12dp"
                android:text="@string/call_reason_lost_item" />

            <Button
                android:id="@+id/button_reason_etc"
                style="@style/TemiOptionButton"
                android:layout_marginTop="12dp"
                android:text="@string/call_reason_etc" />

            <Button
                android:id="@+id/button_submit_call"
                style="@style/TemiPrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/call_submit" />

            <TextView
                android:id="@+id/text_call_status"
                style="@style/TemiStatusText"
                android:text="@string/call_waiting_message" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_call_waiting"
            style="@style/TemiPanel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_call_waiting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/call_waiting_title"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_call_waiting_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/call_waiting_description"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_call_waiting_status"
                style="@style/TemiStatusText"
                android:text="@string/call_waiting_status_message" />

            <Button
                android:id="@+id/button_retry_call"
                style="@style/TemiSecondaryButton"
                android:layout_marginTop="18dp"
                android:text="@string/call_retry"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_waiting_back"
                style="@style/TemiBackButton"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/common_back" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
