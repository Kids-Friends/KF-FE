<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <Button
            android:id="@+id/button_back"
            style="@style/TemiBackButton"
            android:text="@string/common_back" />

        <TextView
            style="@style/TemiScreenTitle"
            android:text="@string/statistics_title" />

        <TextView
            style="@style/TemiScreenDescription"
            android:text="@string/statistics_description" />

        <LinearLayout
            style="@style/TemiPanel"
            android:orientation="vertical">

            <LinearLayout
                style="@style/TemiStatRow"
                android:orientation="horizontal">

                <TextView
                    style="@style/TemiStatLabel"
                    android:text="@string/stat_call_count" />

                <TextView
                    android:id="@+id/text_stat_call_count"
                    style="@style/TemiStatValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/TemiStatRow"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TemiStatLabel"
                    android:text="@string/stat_question_count" />

                <TextView
                    android:id="@+id/text_stat_question_count"
                    style="@style/TemiStatValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/TemiStatRow"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TemiStatLabel"
                    android:text="@string/stat_quiz_play_count" />

                <TextView
                    android:id="@+id/text_stat_quiz_play_count"
                    style="@style/TemiStatValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/TemiStatRow"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TemiStatLabel"
                    android:text="@string/stat_quiz_correct_count" />

                <TextView
                    android:id="@+id/text_stat_quiz_correct_count"
                    style="@style/TemiStatValue" />
            </LinearLayout>

            <Button
                android:id="@+id/button_refresh_statistics"
                style="@style/TemiPrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/statistics_refresh" />

            <TextView
                android:id="@+id/text_stat_summary"
                style="@style/TemiStatusText"
                android:text="@string/common_loading" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
