<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <Button
            android:id="@+id/button_back"
            style="@style/TemiBackButton"
            android:text="@string/common_back" />

        <TextView
            style="@style/TemiScreenTitle"
            android:text="@string/quiz_title" />

        <TextView
            style="@style/TemiScreenDescription"
            android:text="@string/quiz_description" />

        <LinearLayout
            style="@style/TemiPanel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_quiz_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_quiz_option_one"
                style="@style/TemiOptionButton"
                android:layout_marginTop="20dp" />

            <Button
                android:id="@+id/button_quiz_option_two"
                style="@style/TemiOptionButton"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/button_quiz_option_three"
                style="@style/TemiOptionButton"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/button_submit_quiz"
                style="@style/TemiPrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/quiz_submit" />

            <Button
                android:id="@+id/button_reload_quiz"
                style="@style/TemiSecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/quiz_reload" />

            <TextView
                android:id="@+id/text_quiz_result"
                style="@style/TemiStatusText"
                android:text="@string/common_loading" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
