<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    tools:context=".domain.call.ui.VoiceCallActivity">

    <!-- 상단 캐릭터 정보 -->
    <LinearLayout
        android:id="@+id/layout_call_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- 파동 애니메이션용 배경 -->
            <View
                android:id="@+id/view_pulse"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/button_circle_play"
                android:alpha="0.4"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/image_call_character"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="fitCenter"
                android:src="@raw/circle_crong" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_call_character_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            tools:text="크롱" />
    </LinearLayout>

    <!-- 중앙 대화 텍스트 (한 문장만 표시) -->
    <TextView
        android:id="@+id/text_call_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="100dp"
        android:background="@drawable/panel_background"
        android:gravity="center"
        android:padding="40dp"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/layout_call_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_call_header"
        app:layout_constraintVertical_bias="0.4"
        tools:text="안녕! 나랑 같이 놀자!" />

    <!-- 하단 상태 표시 -->
    <LinearLayout
        android:id="@+id/layout_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:background="@drawable/status_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp"
        android:paddingVertical="18dp"
        app:layout_constraintBottom_toTopOf="@id/btn_end_call"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/text_call_status_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textSize="28sp"
            tools:text="📞" />

        <TextView
            android:id="@+id/text_call_status_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="전화 연결 중..." />
    </LinearLayout>

    <!-- 종료 버튼 -->
    <ImageButton
        android:id="@+id/btn_end_call"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/primary_button"
        android:backgroundTint="@color/quiz_red"
        android:elevation="8dp"
        android:padding="28dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="통화 종료"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
