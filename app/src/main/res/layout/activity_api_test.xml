<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ApiTestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <Button
            android:id="@+id/button_back"
            style="@style/TemiBackButton"
            android:layout_gravity="start"
            android:text="@string/common_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="시나리오 직접 수행"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- 1) 입장 및 인사 -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="① 입장 및 인사" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_greeting" style="@style/TemiSecondaryButton" android:text="인사: 넌 정체가 뭐야?" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 2) 회원등록 (Mock) -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="② 회원등록 (Mock)" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_membership" style="@style/TemiSecondaryButton" android:text="회원등록 시작" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 3) 위치 안내 (Mock) -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="③ 위치 안내 (Mock)" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_location" style="@style/TemiSecondaryButton" android:text="미끄럼틀 안내" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 4) 퀴즈 (Mock) -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="④ 퀴즈 (Mock)" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_quiz" style="@style/TemiSecondaryButton" android:text="퀴즈 시작" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 5) 자유 질문 (AI) -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="⑤ 자유 질문 (AI)" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_chat" style="@style/TemiSecondaryButton" android:text="AI 대화창 열기" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 6) 공기질 확인 -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="⑥ 공기질 확인" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_air" style="@style/TemiSecondaryButton" android:text="미세먼지 확인" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 7) 엔딩 -->
        <LinearLayout style="@style/TemiPanel" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="⑦ 엔딩" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_ending" style="@style/TemiSecondaryButton" android:text="작별 인사" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 8) 화재경보 (Emergency) -->
        <LinearLayout style="@style/TemiPanel" android:backgroundTint="#FFE0E0" android:orientation="vertical">
            <TextView style="@style/TemiStatusText" android:text="🔥 화재 발생 !!!" android:textColor="#D32F2F" android:layout_marginTop="0dp" android:textStyle="bold"/>
            <Button android:id="@+id/btn_scen_fire" style="@style/TemiPrimaryButton" android:backgroundTint="#D32F2F" android:text="비상 경보 발령" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/text_test_result"
            style="@style/TemiStatusText"
            android:layout_marginTop="20dp"
            android:text="@string/test_result_waiting" />
    </LinearLayout>
</ScrollView>
