<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ApiTestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:adjustViewBounds="true"
            android:background="@drawable/logo_badge_background"
            android:contentDescription="@string/app_name"
            android:elevation="8dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/main_title"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />

        <LinearLayout
            style="@style/TemiPanel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_wake_status"
                style="@style/TemiStatusText"
                android:layout_marginTop="0dp"
                android:text="@string/voice_wake_standby" />

            <Button
            android:id="@+id/button_start_wake_listening"
            style="@style/TemiSecondaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/voice_button_waiting" />

            <Button
                android:id="@+id/button_server_settings"
                style="@style/TemiSecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/settings_server_button" />

            <Button
                android:id="@+id/button_client_settings"
                style="@style/TemiSecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/settings_client_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_call"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_call" />

            <Button
                android:id="@+id/button_question"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_question" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_quiz"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_quiz" />

            <Button
                android:id="@+id/button_statistics"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_statistics" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_approach"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_approach" />

            <Button
                android:id="@+id/button_location_guide"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_location_guide" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_tts"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_tts" />

            <Button
                android:id="@+id/button_reward"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_reward" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_photo"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_photo" />

            <Button
                android:id="@+id/button_recycling"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_recycling" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
