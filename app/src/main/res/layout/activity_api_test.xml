<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ApiTestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <Button
            android:id="@+id/button_back"
            style="@style/TemiBackButton"
            android:layout_gravity="start"
            android:text="@string/common_back" />

        <ImageView
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:adjustViewBounds="true"
            android:background="@drawable/logo_badge_background"
            android:contentDescription="@string/app_name"
            android:elevation="8dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/main_title"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />

        <LinearLayout
            style="@style/TemiPanel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_wake_status"
                style="@style/TemiStatusText"
                android:layout_marginTop="0dp"
                android:text="@string/voice_wake_standby" />

            <Button
            android:id="@+id/button_start_wake_listening"
            style="@style/TemiSecondaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/voice_button_waiting" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_question"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/menu_question" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_quiz"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/menu_quiz" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_location_guide"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/menu_location_guide" />
        </LinearLayout>

        <!-- ── API 직접 테스트 패널 ───────────────────────── -->
        <LinearLayout
            style="@style/TemiPanel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_panel_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/button_test_ai_chat"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/menu_button"
                    android:backgroundTint="@null"
                    android:elevation="4dp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@string/test_btn_ai_chat" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_test_result"
                style="@style/TemiStatusText"
                android:layout_marginTop="0dp"
                android:text="@string/test_result_waiting" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
