<?xml version="1.0" encoding="utf-8"?>
<!-- 친구 말풍선: 왼쪽 정렬 (프로필 이미지 + 말풍선) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|top"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/image_friend_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="친구 얼굴"
        tools:src="@raw/circle_crong" />

    <TextView
        android:id="@+id/text_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="520dp"
        android:background="@drawable/bubble_friend"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:lineSpacingExtra="2dp"
        tools:text="안녕! 나 크롱이야!" />

</LinearLayout>
