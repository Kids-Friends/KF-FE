<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    tools:context=".domain.call.ui.ChatActivity">

    <!-- 상단 헤더: 뒤로가기 + 캐릭터 프로필 + 이름 (카톡 채팅방 상단) -->
    <LinearLayout
        android:id="@+id/layout_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/status_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_chat_back"
            style="@style/TemiIconButton"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="채팅 종료" />

        <ImageView
            android:id="@+id/image_chat_character"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="친구 얼굴"
            tools:src="@raw/circle_crong" />

        <TextView
            android:id="@+id/text_chat_character_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="크롱" />
    </LinearLayout>

    <!-- 채팅 말풍선 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/layout_chat_header"
        app:layout_constraintBottom_toTopOf="@id/scroll_quick_questions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 빠른 질문 버튼 영역 (가로 스크롤, 버튼은 코드에서 동적 생성) -->
    <HorizontalScrollView
        android:id="@+id/scroll_quick_questions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/status_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/layout_quick_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
