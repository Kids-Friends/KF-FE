<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <Button
            android:id="@+id/button_back"
            style="@style/TemiBackButton"
            android:text="@string/common_back" />

        <TextView
            style="@style/TemiScreenTitle"
            android:text="@string/zone_title" />

        <TextView
            style="@style/TemiScreenDescription"
            android:text="@string/zone_description" />

        <LinearLayout
            style="@style/TemiPanel"
            android:orientation="vertical">

            <Button
                android:id="@+id/button_reload_zones"
                style="@style/TemiSecondaryButton"
                android:text="@string/zone_reload" />

            <TextView
                android:id="@+id/text_zone_status"
                style="@style/TemiStatusText"
                android:text="@string/common_loading" />

            <TextView
                android:id="@+id/text_zone_list"
                style="@style/TemiStatusText"
                android:text="@string/common_loading"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
