<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_blue"
    android:clickable="true"
    android:focusable="true"
    tools:context=".MainActivity">

    <!-- 화면을 가득 채우는 뽀로로 표정 -->
    <ImageView
        android:id="@+id/image_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/face_peaceful" />

    <Button
        android:id="@+id/button_back"
        style="@style/TemiBackButton"
        android:layout_margin="28dp"
        android:text="종료" />

    <Button
        android:id="@+id/button_nav_back"
        style="@style/TemiBackButton"
        android:layout_gravity="end"
        android:layout_margin="28dp"
        android:text="뒤로가기" />

    <Button
        android:id="@+id/button_operator_menu"
        style="@style/TemiBackButton"
        android:layout_gravity="end"
        android:layout_marginEnd="180dp"
        android:layout_marginTop="28dp"
        android:layout_width="180dp"
        android:visibility="gone"
        android:text="@string/home_operator_menu" />

    <!-- 하단에 상태/답변 오버레이 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/text_home_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/panel_background"
            android:maxWidth="900dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="20dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_home_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_background"
            android:paddingHorizontal="32dp"
            android:paddingVertical="18dp"
            android:text="@string/home_idle_hint"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 완료 버튼: 디자인 시스템에 맞춰 친근하게 수정 (빨간색 제거) -->
    <Button
        android:id="@+id/button_complete"
        style="@style/TemiPrimaryButton"
        android:layout_width="280dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:text="다 했어요"
        android:textSize="28sp"
        android:visibility="gone" />

    <!-- 실시간 자막 오버레이 -->
    <LinearLayout
        android:id="@+id/layout_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- "친구야" 호출 시 하단에서 올라오는 기능 버튼 패널 -->
    <LinearLayout
        android:id="@+id/layout_menu_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- 메인 기능 5버튼 -->
        <LinearLayout
            android:id="@+id/layout_menu_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_menu_membership"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/menu_membership" />

            <Button
                android:id="@+id/button_menu_location"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/menu_location_guide" />

            <Button
                android:id="@+id/button_menu_quiz"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/menu_quiz" />

            <Button
                android:id="@+id/button_menu_chat"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/menu_chat" />

            <Button
                android:id="@+id/button_menu_air"
                style="@style/TemiMenuButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_air" />
        </LinearLayout>

        <!-- 위치안내 하위: 장소 선택 버튼 -->
        <LinearLayout
            android:id="@+id/layout_menu_zones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/button_zone_slide"
                style="@style/TemiSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/zone_slide" />

            <Button
                android:id="@+id/button_zone_ball"
                style="@style/TemiSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/zone_ball" />

            <Button
                android:id="@+id/button_zone_toilet"
                style="@style/TemiSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/zone_toilet" />

            <Button
                android:id="@+id/button_zone_tramp"
                style="@style/TemiSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/zone_tramp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
