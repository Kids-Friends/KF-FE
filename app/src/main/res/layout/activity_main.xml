<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_blue"
    android:clickable="true"
    android:focusable="true"
    tools:context=".MainActivity">

    <!-- 화면을 가득 채우는 뽀로로 표정 (1.1배 확대) -->
    <ImageView
        android:id="@+id/image_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:scaleX="1.2"
        android:scaleY="1.2"
        android:src="@drawable/face_peaceful" />

    <ImageButton
        android:id="@+id/button_back"
        style="@style/TemiIconButton"
        android:layout_margin="28dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="종료" />

    <ImageButton
        android:id="@+id/button_nav_back"
        style="@style/TemiIconButton"
        android:layout_gravity="end"
        android:layout_margin="28dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="뒤로가기" />

    <ImageButton
        android:id="@+id/button_operator_menu"
        style="@style/TemiIconButton"
        android:layout_gravity="end"
        android:layout_marginEnd="100dp"
        android:layout_marginTop="28dp"
        android:src="@android:drawable/ic_menu_info_details"
        android:visibility="visible"
        android:contentDescription="서버 확인" />

    <!-- 하단에 상태/답변 오버레이 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/text_home_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/panel_background"
            android:maxWidth="900dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="20dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_home_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_background"
            android:paddingHorizontal="32dp"
            android:paddingVertical="18dp"
            android:text="터치해보세요 !"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 액션 버튼 컨테이너: 디자인 시스템 통일 및 시나리오별 분기 -->
    <LinearLayout
        android:id="@+id/layout_action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/button_continue"
            style="@style/TemiSecondaryButton"
            android:layout_width="280dp"
            android:layout_height="88dp"
            android:layout_marginEnd="20dp"
            android:text="또 할래요"
            android:textSize="28sp" />

        <Button
            android:id="@+id/button_complete"
            style="@style/TemiPrimaryButton"
            android:layout_width="280dp"
            android:layout_height="88dp"
            android:text="다 말했어 !"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- 실시간 자막 오버레이 -->
    <LinearLayout
        android:id="@+id/layout_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 로켓 발사 메뉴 (기존 layout_menu_panel 대체) -->
    <include layout="@layout/rocket_menu" />
</FrameLayout>
