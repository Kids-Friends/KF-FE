<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_call"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_call" />

            <Button
                android:id="@+id/button_question"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_question" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_quiz"
                style="@style/TemiMenuButton"
                android:layout_marginEnd="10dp"
                android:text="@string/menu_quiz" />

            <Button
                android:id="@+id/button_statistics"
                style="@style/TemiMenuButton"
                android:layout_marginStart="10dp"
                android:text="@string/menu_statistics" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
