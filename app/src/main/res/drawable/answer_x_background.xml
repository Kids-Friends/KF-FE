<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FFFFDADA" />
            <stroke
                android:width="4dp"
                android:color="@color/quiz_red" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/answer_x_bg" />
            <stroke
                android:width="4dp"
                android:color="@color/quiz_red" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</selector>
