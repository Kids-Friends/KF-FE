<?xml version="1.0" encoding="utf-8"?>
<!-- X 정답 카드(글래스): 붉은 톤 반투명 유리 + 광택 + 붉은 테두리. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#80E8503A" />
                    <corners android:radius="32dp" />
                    <stroke
                        android:width="4dp"
                        android:color="@color/quiz_red" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/glass_gloss"
                        android:endColor="@color/glass_gloss_clear" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#59E8503A" />
                    <corners android:radius="32dp" />
                    <stroke
                        android:width="3dp"
                        android:color="#B3E8503A" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/glass_gloss"
                        android:endColor="@color/glass_gloss_clear" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
