<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/button_selected" />
            <stroke
                android:width="2dp"
                android:color="@color/kid_orange" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/button_secondary_pressed" />
            <stroke
                android:width="2dp"
                android:color="@color/kid_pink" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/button_secondary" />
            <stroke
                android:width="2dp"
                android:color="@color/panel_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
