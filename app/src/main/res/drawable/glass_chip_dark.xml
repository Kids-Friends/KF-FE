<?xml version="1.0" encoding="utf-8"?>
<!-- 영상/카메라 등 어두운 배경 위 글래스 칩. 흰 텍스트가 읽히도록 짙은 반투명 + 얇은 광택 테두리. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_dark" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_border_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="@color/glass_gloss_clear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
